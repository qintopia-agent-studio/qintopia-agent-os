{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qintopia-agent-os.local/schemas/hermes-core-update-receipt.schema.json",
  "title": "Hermes Core Update Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_type",
    "outcome",
    "strategy",
    "repository",
    "tag",
    "commit_sha",
    "source_archive_sha256",
    "artifact_identity_sha256",
    "previous_version",
    "previous_commit_sha",
    "new_version",
    "started_at",
    "completed_at",
    "upstream_receipt_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_type": { "const": "hermes-core-update" },
    "outcome": { "const": "success" },
    "strategy": { "const": "hermes-update-clean-candidate" },
    "repository": {
      "const": "https://github.com/NousResearch/hermes-agent.git"
    },
    "tag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_archive_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "previous_commit_sha": {
      "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{40}$" }, { "type": "null" }]
    },
    "new_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "started_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "completed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "upstream_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

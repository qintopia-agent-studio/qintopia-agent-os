# DEPLOYABLE SCAFFOLD / DEFAULT DISABLED
# Render only through the owner-gated release/current ingress operation. Both values
# are server-local secrets and must never be committed, logged, or passed in a deploy
# request.
location = /qiwe/webhook/__QIWE_PUBLIC_PATH_TOKEN__ {
    limit_except POST {
        deny all;
    }

    access_log off;
    error_log /dev/null crit;
    log_not_found off;

    client_max_body_size 1m;
    client_body_timeout 2s;
    proxy_connect_timeout 1s;
    proxy_read_timeout 2s;
    proxy_send_timeout 2s;
    proxy_request_buffering on;

    proxy_http_version 1.1;
    proxy_pass_request_headers off;
    proxy_set_header Host 127.0.0.1;
    proxy_set_header Connection "";
    proxy_set_header Content-Type application/json;
    proxy_set_header X-Qintopia-Qiwe-Ingress-Auth __QIWE_INTERNAL_AUTH_TOKEN__;
    proxy_pass http://127.0.0.1:18661/qiwe/webhook;
}

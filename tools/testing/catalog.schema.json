{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qintopia.local/testing/catalog.schema.json",
  "title": "Qintopia local business test catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "businesses", "gaps"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "businesses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/business"
      },
      "minItems": 1
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]*$",
      "minLength": 2,
      "maxLength": 120
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["real", "simulated"],
      "properties": {
        "real": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "simulated": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["python", "docker", "postgres", "rust", "node", "java17"]
      },
      "uniqueItems": true
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "filter": {
          "type": "string",
          "minLength": 1
        },
        "count_strategy": {
          "type": "string",
          "enum": ["junit", "unittest", "cargo", "node_test"]
        },
        "nodeid": {
          "type": "string",
          "minLength": 1
        },
        "pythonpath": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "aliases",
        "executor",
        "target",
        "requires",
        "timeout_seconds",
        "required",
        "boundary"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "aliases": {
          "$ref": "#/$defs/aliases"
        },
        "executor": {
          "type": "string",
          "enum": ["pytest", "unittest", "cargo", "node"]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "requires": {
          "$ref": "#/$defs/requires"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "required": {
          "type": "boolean"
        },
        "boundary": {
          "$ref": "#/$defs/boundary"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "business": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "aliases", "scenarios"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "aliases": {
          "$ref": "#/$defs/aliases"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scenario"
          },
          "minItems": 1
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "path", "reason"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    }
  }
}

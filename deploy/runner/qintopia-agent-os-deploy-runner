#!/usr/bin/env bash
set -euo pipefail

RUNNER_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
STATE_DIR="${QINTOPIA_DEPLOY_RUNNER_STATE_DIR:-/var/lib/qintopia-agent-os-deploy}"
REQUEST_DIR="${STATE_DIR}/requests"
RESULT_DIR="${STATE_DIR}/results"
LOCK_FILE="${STATE_DIR}/deploy.lock"
RELEASE_ROOT="${QINTOPIA_RELEASE_ROOT:-/home/ubuntu/qintopia-agent-os-releases}"
ENV_FILE="${QINTOPIA_COS_ENV_FILE:-/etc/qintopia/cos-artifacts.env}"

usage() {
  cat <<'USAGE'
Usage:
  qintopia-agent-os-deploy-runner --request-file <file> [--dry-run]

Runs the fixed Qintopia Agent OS release promotion flow for a validated deploy request.
This command is intended for a root-owned systemd service or timer. It does not execute
arbitrary request commands.
USAGE
}

request_file=""
force_dry_run=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --request-file)
      request_file="${2:-}"
      shift 2
      ;;
    --dry-run)
      force_dry_run=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ -z "$request_file" || ! -f "$request_file" ]]; then
  echo "--request-file must point to an existing deploy request JSON" >&2
  exit 2
fi

mkdir -p "$REQUEST_DIR" "$RESULT_DIR" "$RELEASE_ROOT" "$(dirname "$LOCK_FILE")"

if [[ -f "$ENV_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$ENV_FILE"
fi

json_get() {
  python3 - "$request_file" "$1" <<'PY'
import json
import os
import sys
with open(sys.argv[1], encoding="utf-8") as fh:
    data = json.load(fh)
value = data
for part in sys.argv[2].split("."):
    if not isinstance(value, dict) or part not in value:
        value = ""
        break
    value = value[part]
if isinstance(value, list):
    print(",".join(value))
else:
    print(str(value).lower() if isinstance(value, bool) else value)
PY
}

validate_request() {
  python3 - "$request_file" <<'PY'
import hmac
import hashlib
import json
import os
import re
import sys
from datetime import datetime, timezone

path = sys.argv[1]
allowed_scope = {
    "sidecar-runtime",
    "deploy-bundle",
    "hermes-plugins",
    "hermes-profile-erhua",
    "production-activation",
    "production-observation",
    "production-hermes-cron-apply",
    "production-legacy-cron-retirement",
    "production-runtime-one-shot",
}
allowed_runtime_artifact_profiles = {"huabaosi-production", "qiwe-production"}
allowed_activation_targets = {
    "erhua-morning-brief",
    "xiaoman-weekly-recruitment",
    "xiaoman-weekly-plan-confirmation",
    "xiaoman-weekly-preview",
    "xiaoman-daily-case-report-auto-publish",
}
allowed_legacy_cron_retirement_targets = {
    "erhua-legacy-cron",
    "xiaoman-legacy-cron",
}
allowed_hermes_cron_apply_targets = {
    "erhua-morning-brief",
    "xiaoman-daily-case-report",
    "xiaoman-weekly-recruitment",
    "xiaoman-weekly-plan-confirmation",
    "xiaoman-weekly-preview",
}
allowed_hermes_cron_apply_modes = {"install", "enable"}
allowed_observation_targets = {
    "qiwe-image-send",
    "xiaoman-daily-case-report-auto-publish",
    "hermes-cron-snapshot",
    "hermes-cron-live-parity",
    "erhua-morning-brief-worker-run",
    "xiaoman-daily-case-report-worker-run",
    "xiaoman-weekly-recruitment-worker-run",
    "xiaoman-weekly-plan-confirmation-worker-run",
    "xiaoman-weekly-preview-worker-run",
}
allowed_runtime_one_shot_targets = {
    "erhua-morning-brief",
    "hermes-cron-snapshot-install",
    "xiaoman-daily-case-report-auto-publish-backfill",
}
allowed_targets = {
    "qintopia-system-services",
    "hermes-erhua",
    "hermes-wenyuange",
    "hermes-xiaoman",
    "hermes-silaoshi",
    "hermes-huabaosi",
    "hermes-guanerye",
}
sha = re.compile(r"^[0-9a-f]{40}$")
request_id = re.compile(r"^deploy-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7,40}$")

def fail(message):
    raise SystemExit(f"invalid deploy request: {message}")

def require_string(data, key):
    value = data.get(key)
    if not isinstance(value, str) or not value:
        fail(f"{key} must be a non-empty string")
    return value

def parse_datetime(value, key):
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        fail(f"{key} must be an ISO date-time")

def canonical_json(value):
    if isinstance(value, list):
        return "[" + ",".join(canonical_json(item) for item in value) + "]"
    if isinstance(value, dict):
        return "{" + ",".join(
            json.dumps(key, separators=(",", ":")) + ":" + canonical_json(value[key])
            for key in sorted(value)
        ) + "}"
    return json.dumps(value, ensure_ascii=False, separators=(",", ":"))

def signing_envelope(request, signature_metadata):
    return {"request": request, "signature": signature_metadata}

with open(path, encoding="utf-8") as fh:
    data = json.load(fh)

if data.get("schema_version") != 1:
    fail("schema_version must be 1")
if data.get("environment") != "production":
    fail("environment must be production")
if data.get("repository") != "qintopia-agent-studio/qintopia-agent-os":
    fail("repository mismatch")
if not request_id.fullmatch(require_string(data, "request_id")):
    fail("request_id format mismatch")
for key in ("commit_sha", "runtime_sha", "deploy_bundle_sha", "release_sha"):
    if not sha.fullmatch(require_string(data, key)):
        fail(f"{key} must be a lowercase 40-character SHA")
if data.get("runtime_artifact_profile") not in allowed_runtime_artifact_profiles:
    fail("runtime_artifact_profile must be an approved production profile")

created_at = parse_datetime(require_string(data, "created_at"), "created_at")
expires_at = parse_datetime(require_string(data, "expires_at"), "expires_at")
now = datetime.now(timezone.utc)
if created_at.tzinfo is None or expires_at.tzinfo is None:
    fail("created_at and expires_at must include timezone")
if expires_at <= now:
    fail("request is expired")
if expires_at <= created_at:
    fail("expires_at must be after created_at")

release_scope = data.get("release_scope")
if not isinstance(release_scope, list) or not release_scope:
    fail("release_scope must be a non-empty list")
if set(release_scope) - allowed_scope or len(set(release_scope)) != len(release_scope):
    fail("release_scope contains unsupported or duplicate entries")

restart_targets = data.get("restart_targets")
if not isinstance(restart_targets, list) or not restart_targets:
    fail("restart_targets must be a non-empty list")
if set(restart_targets) - allowed_targets or len(set(restart_targets)) != len(restart_targets):
    fail("restart_targets contains unsupported or duplicate entries")
if "hermes-profile-erhua" in release_scope:
    if release_scope != ["hermes-profile-erhua"]:
        fail("hermes-profile-erhua must be the only release scope")
    if restart_targets != ["hermes-erhua"]:
        fail("hermes-profile-erhua requires exactly hermes-erhua")
    if data.get("rollback_on_smoke_failure") is not True:
        fail("hermes-profile-erhua requires rollback_on_smoke_failure=true")
    dry_run_reference = data.get("profile_dry_run_request_id")
    if data.get("dry_run") is False:
        if not isinstance(dry_run_reference, str) or not request_id.fullmatch(dry_run_reference):
            fail("non-dry-run Erhua profile activation requires profile_dry_run_request_id")
    elif dry_run_reference is not None:
        fail("dry-run Erhua profile request must not set profile_dry_run_request_id")
if "production-activation" in release_scope:
    if release_scope != ["production-activation"]:
        fail("production-activation must be the only release scope")
    if restart_targets != ["qintopia-system-services"]:
        fail("production-activation requires exactly qintopia-system-services")
    if data.get("rollback_on_smoke_failure") is not False:
        fail("production-activation requires rollback_on_smoke_failure=false")
    if data.get("dry_run") is not False:
        fail("production-activation does not support dry_run")
    activation = data.get("activation")
    if not isinstance(activation, dict):
        fail("production-activation requires activation metadata")
    targets = activation.get("targets")
    if not isinstance(targets, list) or not targets:
        fail("activation.targets must be a non-empty list")
    if set(targets) - allowed_activation_targets or len(set(targets)) != len(targets):
        fail("activation.targets contains unsupported or duplicate entries")
    if data.get("profile_dry_run_request_id") is not None:
        fail("production-activation must not set profile_dry_run_request_id")
elif data.get("activation") is not None:
    fail("activation metadata is only allowed for production-activation")

if "production-observation" in release_scope:
    if release_scope != ["production-observation"]:
        fail("production-observation must be the only release scope")
    if restart_targets != ["qintopia-system-services"]:
        fail("production-observation requires exactly qintopia-system-services")
    if data.get("rollback_on_smoke_failure") is not False:
        fail("production-observation requires rollback_on_smoke_failure=false")
    if data.get("dry_run") is not False:
        fail("production-observation does not support dry_run")
    observation = data.get("observation")
    if not isinstance(observation, dict):
        fail("production-observation requires observation metadata")
    targets = observation.get("targets")
    if not isinstance(targets, list) or not targets:
        fail("observation.targets must be a non-empty list")
    if set(targets) - allowed_observation_targets or len(set(targets)) != len(targets):
        fail("observation.targets contains unsupported or duplicate entries")
    if data.get("profile_dry_run_request_id") is not None:
        fail("production-observation must not set profile_dry_run_request_id")
elif data.get("observation") is not None:
    fail("observation metadata is only allowed for production-observation")

if "production-legacy-cron-retirement" in release_scope:
    if release_scope != ["production-legacy-cron-retirement"]:
        fail("production-legacy-cron-retirement must be the only release scope")
    if restart_targets != ["qintopia-system-services"]:
        fail("production-legacy-cron-retirement requires exactly qintopia-system-services")
    if data.get("rollback_on_smoke_failure") is not False:
        fail("production-legacy-cron-retirement requires rollback_on_smoke_failure=false")
    if data.get("dry_run") is not False:
        fail("production-legacy-cron-retirement does not support dry_run")
    retirement = data.get("legacy_cron_retirement")
    if not isinstance(retirement, dict):
        fail("production-legacy-cron-retirement requires legacy_cron_retirement metadata")
    targets = retirement.get("targets")
    if not isinstance(targets, list) or not targets:
        fail("legacy_cron_retirement.targets must be a non-empty list")
    if set(targets) - allowed_legacy_cron_retirement_targets or len(set(targets)) != len(targets):
        fail("legacy_cron_retirement.targets contains unsupported or duplicate entries")
    if data.get("profile_dry_run_request_id") is not None:
        fail("production-legacy-cron-retirement must not set profile_dry_run_request_id")
elif data.get("legacy_cron_retirement") is not None:
    fail("legacy_cron_retirement metadata is only allowed for production-legacy-cron-retirement")

if "production-hermes-cron-apply" in release_scope:
    if release_scope != ["production-hermes-cron-apply"]:
        fail("production-hermes-cron-apply must be the only release scope")
    if restart_targets != ["qintopia-system-services"]:
        fail("production-hermes-cron-apply requires exactly qintopia-system-services")
    if data.get("rollback_on_smoke_failure") is not False:
        fail("production-hermes-cron-apply requires rollback_on_smoke_failure=false")
    if data.get("dry_run") is not False:
        fail("production-hermes-cron-apply does not support dry_run")
    hermes_cron_apply = data.get("hermes_cron_apply")
    if not isinstance(hermes_cron_apply, dict):
        fail("production-hermes-cron-apply requires hermes_cron_apply metadata")
    targets = hermes_cron_apply.get("targets")
    if not isinstance(targets, list) or not targets:
        fail("hermes_cron_apply.targets must be a non-empty list")
    if set(targets) - allowed_hermes_cron_apply_targets or len(set(targets)) != len(targets):
        fail("hermes_cron_apply.targets contains unsupported or duplicate entries")
    mode = hermes_cron_apply.get("mode")
    if mode not in allowed_hermes_cron_apply_modes:
        fail("hermes_cron_apply.mode must be install or enable")
    if data.get("profile_dry_run_request_id") is not None:
        fail("production-hermes-cron-apply must not set profile_dry_run_request_id")
elif data.get("hermes_cron_apply") is not None:
    fail("hermes_cron_apply metadata is only allowed for production-hermes-cron-apply")

if "production-runtime-one-shot" in release_scope:
    if release_scope != ["production-runtime-one-shot"]:
        fail("production-runtime-one-shot must be the only release scope")
    if restart_targets != ["qintopia-system-services"]:
        fail("production-runtime-one-shot requires exactly qintopia-system-services")
    if data.get("rollback_on_smoke_failure") is not False:
        fail("production-runtime-one-shot requires rollback_on_smoke_failure=false")
    if data.get("dry_run") is not False:
        fail("production-runtime-one-shot does not support dry_run")
    runtime_one_shot = data.get("runtime_one_shot")
    if not isinstance(runtime_one_shot, dict):
        fail("production-runtime-one-shot requires runtime_one_shot metadata")
    targets = runtime_one_shot.get("targets")
    if not isinstance(targets, list) or len(targets) != 1:
        fail("runtime_one_shot.targets must contain exactly one fixed target")
    if set(targets) - allowed_runtime_one_shot_targets or len(set(targets)) != len(targets):
        fail("runtime_one_shot.targets contains unsupported or duplicate entries")
    approval = runtime_one_shot.get("approval")
    target = targets[0]
    expected_approvals = {
        "erhua-morning-brief": "approved-production-erhua-morning-brief-one-shot",
        "hermes-cron-snapshot-install": "approved-production-hermes-cron-snapshot",
        "xiaoman-daily-case-report-auto-publish-backfill": "approved-production-xiaoman-daily-case-report-auto-publish-backfill",
    }
    if approval != expected_approvals[target]:
        fail("runtime_one_shot.approval does not match the fixed target approval")
    backfill_date = runtime_one_shot.get("backfill_date")
    if target == "xiaoman-daily-case-report-auto-publish-backfill":
        if not isinstance(backfill_date, str) or not re.fullmatch(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}$", backfill_date):
            fail("runtime_one_shot.backfill_date is required for Xiaoman daily report backfill")
    elif backfill_date is not None:
        fail("runtime_one_shot.backfill_date is only allowed for Xiaoman daily report backfill")
    if data.get("profile_dry_run_request_id") is not None:
        fail("production-runtime-one-shot must not set profile_dry_run_request_id")
elif data.get("runtime_one_shot") is not None:
    fail("runtime_one_shot metadata is only allowed for production-runtime-one-shot")

for key in ("rollback_on_smoke_failure", "dry_run"):
    if not isinstance(data.get(key), bool):
        fail(f"{key} must be boolean")

signature = data.get("signature")
if not isinstance(signature, dict):
    fail("signature must be an object")
if signature.get("algorithm") != "hmac-sha256":
    fail("signature algorithm mismatch")
if signature.get("issuer") != "github-actions":
    fail("signature issuer mismatch")
if not isinstance(signature.get("key_id"), str) or not signature["key_id"]:
    fail("signature key_id must be a non-empty string")
expected_key_id = os.environ.get("DEPLOY_REQUEST_SIGNING_KEY_ID", "")
if not expected_key_id:
    fail("DEPLOY_REQUEST_SIGNING_KEY_ID is required")
if signature.get("key_id") != expected_key_id:
    fail("signature key_id mismatch")
signature_signed_at = parse_datetime(require_string(signature, "signed_at"), "signature.signed_at")
if signature_signed_at.tzinfo is None:
    fail("signature.signed_at must include timezone")
signature_value = require_string(signature, "value")
if not re.fullmatch(r"^[0-9a-f]{64}$", signature_value):
    fail("signature value format mismatch")
signing_key = os.environ.get("DEPLOY_REQUEST_SIGNING_KEY", "")
if not signing_key:
    fail("DEPLOY_REQUEST_SIGNING_KEY is required")
unsigned = dict(data)
signature_metadata = dict(unsigned.pop("signature", {}))
signature_metadata.pop("value", None)
expected_signature = hmac.new(
    signing_key.encode("utf-8"),
    canonical_json(signing_envelope(unsigned, signature_metadata)).encode("utf-8"),
    hashlib.sha256,
).hexdigest()
if not hmac.compare_digest(signature_value, expected_signature):
    fail("signature verification failed")

cos = data.get("cos")
if not isinstance(cos, dict):
    fail("cos must be an object")
if cos.get("prefix") != "qintopia-agent-os":
    fail("cos.prefix must be qintopia-agent-os")
expected_request_key = f"qintopia-agent-os/deploy-requests/production/requests/{data['request_id']}.json"
expected_result_key = f"qintopia-agent-os/deploy-results/production/{data['request_id']}.json"
if cos.get("request_key") != expected_request_key:
    fail("cos.request_key does not match request_id")
if cos.get("result_key") != expected_result_key:
    fail("cos.result_key does not match request_id")
require_string(cos, "bucket")
require_string(cos, "region")
expected_bucket = os.environ.get("TENCENT_COS_BUCKET")
expected_region = os.environ.get("TENCENT_COS_REGION")
if expected_bucket and cos.get("bucket") != expected_bucket:
    fail("cos.bucket does not match runner environment")
if expected_region and cos.get("region") != expected_region:
    fail("cos.region does not match runner environment")
PY
}

validate_request

request_id="$(json_get request_id)"
release_sha="$(json_get release_sha)"
commit_sha="$(json_get commit_sha)"
runtime_sha="$(json_get runtime_sha)"
runtime_artifact_profile="$(json_get runtime_artifact_profile)"
deploy_bundle_sha="$(json_get deploy_bundle_sha)"
release_scope="$(json_get release_scope)"
restart_targets="$(json_get restart_targets)"
dry_run="$(json_get dry_run)"
rollback_on_smoke_failure="$(json_get rollback_on_smoke_failure)"
profile_dry_run_request_id="$(json_get profile_dry_run_request_id)"
activation_targets="$(json_get activation.targets)"
observation_targets="$(json_get observation.targets)"
legacy_cron_retirement_targets="$(json_get legacy_cron_retirement.targets)"
hermes_cron_apply_targets="$(json_get hermes_cron_apply.targets)"
hermes_cron_apply_mode="$(json_get hermes_cron_apply.mode)"
runtime_one_shot_targets="$(json_get runtime_one_shot.targets)"
runtime_one_shot_backfill_date="$(json_get runtime_one_shot.backfill_date)"
runtime_one_shot_approval="$(json_get runtime_one_shot.approval)"
if [[ "$force_dry_run" == true ]]; then
  dry_run=true
fi

result_file="${RESULT_DIR}/${request_id}.json"
started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
deploy_stage="starting"
deploy_failure_stage=""
deploy_failure_status=""

write_result() {
  local status="$1"
  local error="${2:-}"
  local rollback_attempted="${3:-false}"
  local rollback_status="${4:-not_needed}"
  local rollback_target="${5:-}"
  local previous_target=""
  local current_target=""
  if [[ -e "${RELEASE_ROOT}/previous" || -L "${RELEASE_ROOT}/previous" ]]; then
    previous_target="$(readlink -f "${RELEASE_ROOT}/previous" 2>/dev/null || true)"
  fi
  if [[ -e "${RELEASE_ROOT}/current" || -L "${RELEASE_ROOT}/current" ]]; then
    current_target="$(readlink -f "${RELEASE_ROOT}/current" 2>/dev/null || true)"
  fi
  previous_sha="${previous_target##*/}"
  python3 - "$result_file" "$request_id" "$status" "$started_at" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$release_sha" "$commit_sha" \
    "$runtime_sha" "$runtime_artifact_profile" "$deploy_bundle_sha" "$previous_sha" \
    "$current_target" "$restart_targets" "$error" "$rollback_attempted" \
    "$rollback_status" "$rollback_target" "${RESULT_DIR}/${request_id}.profile.json" \
    "${RESULT_DIR}/${request_id}.smoke.json" "${RESULT_DIR}/${request_id}.restore.json" \
    "$release_scope" "$deploy_failure_stage" "$deploy_failure_status" \
    "$promoted_current" "$profile_activation_attempted" \
    "${RESULT_DIR}/${request_id}.activation.json" \
    "${RESULT_DIR}/${request_id}.observation.json" \
    "${RESULT_DIR}/${request_id}.legacy-cron-retirement.json" \
    "${RESULT_DIR}/${request_id}.hermes-cron-apply.json" \
    "${RESULT_DIR}/${request_id}.runtime-one-shot.json" <<'PY'
import json
import os
import sys

(
    path,
    request_id,
    status,
    started_at,
    finished_at,
    release_sha,
    commit_sha,
    runtime_sha,
    runtime_artifact_profile,
    deploy_bundle_sha,
    previous_sha,
    current_target,
    restart_targets,
    error,
    rollback_attempted,
    rollback_status,
    rollback_target,
    profile_evidence_path,
    smoke_evidence_path,
    restore_evidence_path,
    release_scope,
    deploy_failure_stage,
    deploy_failure_status,
    promoted_current,
    profile_activation_attempted,
    activation_evidence_path,
    observation_evidence_path,
    legacy_cron_retirement_evidence_path,
    hermes_cron_apply_evidence_path,
    runtime_one_shot_evidence_path,
) = sys.argv[1:31]

runner_check = {
    "name": "deploy-runner",
    "status": "passed" if status.endswith("succeeded") else "failed",
}
if deploy_failure_stage:
    detail = {
        "failure_stage": deploy_failure_stage,
        "exit_status": int(deploy_failure_status or "0"),
        "promoted_current": promoted_current == "true",
        "profile_activation_attempted": profile_activation_attempted == "true",
    }
    runner_check["detail"] = json.dumps(detail, separators=(",", ":"))

result = {
    "schema_version": 1,
    "request_id": request_id,
    "environment": "production",
    "status": status,
    "started_at": started_at,
    "finished_at": finished_at,
    "release_sha": release_sha,
    "commit_sha": commit_sha,
    "runtime_sha": runtime_sha,
    "runtime_artifact_profile": runtime_artifact_profile,
    "deploy_bundle_sha": deploy_bundle_sha,
    "release_scope": [item for item in release_scope.split(",") if item],
    "previous_sha": previous_sha,
    "current_target": current_target,
    "restart_targets": [item for item in restart_targets.split(",") if item],
    "checks": [runner_check],
    "rollback": {
        "attempted": rollback_attempted == "true",
        "status": rollback_status,
    },
}
if os.path.isfile(profile_evidence_path):
    with open(profile_evidence_path, encoding="utf-8") as fh:
        profile_evidence = json.load(fh)
    result["checks"].append({
        "name": "erhua-profile-overlay",
        "status": "passed" if status.endswith("succeeded") else "failed",
        "detail": json.dumps(profile_evidence, separators=(",", ":")),
    })
expected_smoke_phase = "activation" if status == "succeeded" else "rollback" if status == "rolled_back" else ""
if expected_smoke_phase and os.path.isfile(smoke_evidence_path):
    with open(smoke_evidence_path, encoding="utf-8") as fh:
        smoke_evidence = json.load(fh)
    result["checks"].append({
        "name": "erhua-profile-smoke",
        "status": "passed" if smoke_evidence.get("phase") == expected_smoke_phase else "failed",
        "detail": json.dumps(smoke_evidence, separators=(",", ":")),
    })
if status == "rolled_back" and os.path.isfile(restore_evidence_path):
    with open(restore_evidence_path, encoding="utf-8") as fh:
        restore_evidence = json.load(fh)
    result["checks"].append({
        "name": "erhua-profile-restore",
        "status": "passed" if restore_evidence.get("phase") == "restored" else "failed",
        "detail": json.dumps(restore_evidence, separators=(",", ":")),
    })
if os.path.isfile(activation_evidence_path):
    with open(activation_evidence_path, encoding="utf-8") as fh:
        activation_evidence = json.load(fh)

run_promotion() {
  if [[ "$release_scope" == "production-hermes-cron-apply" ]]; then
    run_production_hermes_cron_apply
    return
  fi

  if [[ "$release_scope" == "production-runtime-one-shot" ]]; then
    run_production_runtime_one_shot
    return
  fi

  if [[ "$release_scope" == "production-legacy-cron-retirement" ]]; then
    run_production_legacy_cron_retirement
    return
  fi

  if [[ "$release_scope" == "production-activation" ]]; then
    run_production_activation
    return
  fi

  if [[ "$release_scope" == "production-observation" ]]; then
    run_production_observation
    return
  fi

  if [[ "$release_scope" == "hermes-profile-erhua" ]]; then
    deploy_stage="validate-current-profile-release"
    validate_current_profile_release || return $?
    profile_args=(
      --release-dir "$profile_release_dir"
      --state-dir "$STATE_DIR"
      --request-id "$request_id"
      --release-sha "$release_sha"
    )
    if [[ "$dry_run" == "true" ]]; then
      profile_args+=(--dry-run)
    else
      profile_args+=(--dry-run-request-id "$profile_dry_run_request_id")
    fi
    profile_status=0
    deploy_stage="activate-erhua-profile"
    "$profile_release_dir/deploy/runner/activate-erhua-profile.sh" \
      "${profile_args[@]}" || profile_status=$?
    if [[ "$dry_run" != "true" && -f "${STATE_DIR}/profile-backups/${request_id}/metadata.json" ]]; then
      profile_activation_attempted=true
    fi
    if [[ "$profile_status" -ne 0 ]]; then
      return "$profile_status"
    fi
    if [[ "$dry_run" == "true" ]]; then
      write_result dry_run_succeeded
      return
    fi
    profile_activation_attempted=true
    deploy_stage="assert-current-profile-release"
    assert_current_profile_release || return $?
    rm -f "${RESULT_DIR}/${request_id}.smoke.json"
    deploy_stage="profile-smoke-release"
    "$profile_release_dir/deploy/runner/smoke-release.sh" \
      --release-root "$RELEASE_ROOT" \
      --profile-release-dir "$profile_release_dir" \
      --profile-metadata "${STATE_DIR}/profile-backups/${request_id}/metadata.json" \
      --restart-targets "$restart_targets" \
      --log-since "$started_at" \
      --evidence-output "${RESULT_DIR}/${request_id}.smoke.json" \
      --evidence-phase activation || return $?
    deploy_stage="assert-current-profile-release"
    assert_current_profile_release || return $?
    deploy_stage="write-success-result"
    write_result succeeded
    return
  fi

  promote_args=(
    --request-file "$request_file"
    --release-root "$RELEASE_ROOT"
  )
  if [[ "$dry_run" == "true" ]]; then
    promote_args+=(--dry-run)
  fi
  deploy_stage="promote-release"
  "${RUNNER_DIR}/promote-release.sh" \
    "${promote_args[@]}" || return $?
  if [[ "$dry_run" == "true" ]]; then
    deploy_stage="write-dry-run-result"
    write_result dry_run_succeeded
  else
    promoted_current=true
    deploy_stage="install-release-systemd-units"
    "${RUNNER_DIR}/install-release-systemd-units.sh" \
      --release-root "$RELEASE_ROOT" \
      --release-sha "$release_sha" || return $?
    deploy_stage="smoke-release"
    "${RUNNER_DIR}/smoke-release.sh" \
      --release-root "$RELEASE_ROOT" \
      --restart-targets "$restart_targets" \
      --log-since "$started_at" || return $?
    deploy_stage="write-success-result"
    write_result succeeded
  fi
}

(
  flock -n 9 || {
    echo "another deploy is already running" >&2
    exit 75
  }
  promoted_current=false
  profile_activation_attempted=false
  set +e
  run_promotion
  status=$?
  set -e
  if [[ "$status" -ne 0 ]]; then
    deploy_failure_stage="$deploy_stage"
    deploy_failure_status="$status"
    if [[ "$release_scope" == "hermes-profile-erhua" && "$profile_activation_attempted" == "true" && "$rollback_on_smoke_failure" == "true" ]]; then
      rollback_target="$profile_release_dir"
      rollback_ok=true
      assert_current_profile_release || rollback_ok=false
      "$profile_release_dir/deploy/runner/rollback-erhua-profile.sh" \
        --release-dir "$profile_release_dir" \
        --state-dir "$STATE_DIR" \
        --request-id "$request_id" \
        --evidence-output "${RESULT_DIR}/${request_id}.restore.json" || rollback_ok=false
      assert_current_profile_release || rollback_ok=false
      rm -f "${RESULT_DIR}/${request_id}.smoke.json"
      "$profile_release_dir/deploy/runner/smoke-release.sh" \
        --release-root "$RELEASE_ROOT" \
        --profile-release-dir "$profile_release_dir" \
        --restart-targets "$restart_targets" \
        --skip-erhua-provider-check \
        --log-since "$started_at" \
        --evidence-output "${RESULT_DIR}/${request_id}.smoke.json" \
        --evidence-phase rollback || rollback_ok=false
      assert_current_profile_release || rollback_ok=false
      if [[ "$rollback_ok" == "true" ]]; then
        write_result rolled_back "profile activation failed during ${deploy_failure_stage} (exit ${deploy_failure_status}) and rollback succeeded" \
          true succeeded "$rollback_target"
      else
        write_result failed "profile activation failed during ${deploy_failure_stage} (exit ${deploy_failure_status}) and rollback failed" \
          true failed "$rollback_target"
      fi
    elif [[ "$promoted_current" == "true" && "$rollback_on_smoke_failure" == "true" ]]; then
      rollback_target="$(readlink -f "${RELEASE_ROOT}/previous" 2>/dev/null || true)"
      rollback_ok=true
      "${RUNNER_DIR}/rollback-release.sh" --release-root "$RELEASE_ROOT" || rollback_ok=false
      "${RUNNER_DIR}/smoke-release.sh" \
        --release-root "$RELEASE_ROOT" \
        --restart-targets "$restart_targets" \
        --skip-erhua-provider-check \
        --log-since "$started_at" || rollback_ok=false
      if [[ "$(readlink -f "${RELEASE_ROOT}/current" 2>/dev/null || true)" != "$rollback_target" ]]; then
        rollback_ok=false
      fi
      if [[ "$rollback_ok" == "true" ]]; then
        write_result rolled_back "deployment failed during ${deploy_failure_stage} (exit ${deploy_failure_status}) and rollback succeeded" \
          true succeeded "$rollback_target"
      else
        write_result failed "deployment failed during ${deploy_failure_stage} (exit ${deploy_failure_status}) and rollback failed" \
          true failed "$rollback_target"
      fi
    else
      write_result failed "deployment failed during ${deploy_failure_stage} (exit ${deploy_failure_status})"
    fi
    exit "$status"
  fi
) 9>"$LOCK_FILE"

echo "Deploy result: ${result_file}"

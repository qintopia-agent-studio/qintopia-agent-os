observation_success_detail() {
  local log_file="$1"
  python3 - "$log_file" <<'PY'
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
safe_patterns = [
    re.compile(r"^(qiwe_image_send_production_observation_state)=(enabled|disabled)$"),
    re.compile(r"^(xiaoman_daily_case_report_auto_publish_observation_state)=(enabled|disabled)$"),
    re.compile(r"^(hermes_cron_snapshot_observation_result)=(success)$"),
    re.compile(r"^(hermes_cron_snapshot_timer_unit_present)=(true)$"),
    re.compile(r"^(hermes_cron_snapshot_service_unit_present)=(true)$"),
    re.compile(r"^(hermes_cron_snapshot_repo_present)=(true)$"),
    re.compile(r"^(hermes_cron_snapshot_remote_absent)=(true)$"),
    re.compile(r"^(hermes_cron_snapshot_latest_commit_epoch)=([0-9]{9,12})$"),
    re.compile(r"^(hermes_cron_live_parity_result)=(success)$"),
    re.compile(r"^(hermes_cron_live_parity_reviewed_count)=([0-9]{1,3})$"),
    re.compile(r"^(hermes_cron_live_parity_live_count)=([0-9]{1,3})$"),
    re.compile(r"^(hermes_cron_live_parity_enabled_count)=([0-9]{1,3})$"),
    re.compile(r"^([a-z0-9_]+_worker_run_result)=(success|not_started)$"),
    re.compile(r"^([a-z0-9_]+_worker_run_epoch)=([0-9]{9,12})$"),
    re.compile(r"^([a-z0-9_]+_worker_summary_present)=(true)$"),
    re.compile(r"^([a-z0-9_]+_worker_summary_date)=([0-9]{4}-[0-9]{2}-[0-9]{2})$"),
    re.compile(r"^(xiaoman_daily_case_report_worker_(?:message_count|participant_count|case_count|character_count|hot_topic_count))=([0-9]{1,6})$"),
    re.compile(r"^(xiaoman_daily_case_report_worker_character_universe_(?:schema_version|source))=([A-Za-z0-9_.-]{1,80})$"),
    re.compile(r"^(xiaoman_daily_case_report_worker_character_universe_(?:raw_messages_included|profile_fact_text_included|creative_profile_public_surface_allowed))=(false)$"),
    re.compile(r"^(xiaoman_daily_case_report_worker_character_universe_(?:people_count|topic_count|event_count|meme_count|callback_count|relationship_count|creative_profile_candidate_count|storyline_candidate_count|edge_count))=([0-9]{1,6})$"),
    re.compile(r"^(xiaoman_daily_case_report_worker_private_review_bundle_(?:public_surface_allowed|raw_message_rows_included|profile_fact_text_included))=(false)$"),
    re.compile(r"^(xiaoman_daily_case_report_worker_private_review_bundle_review_required)=(true)$"),
    re.compile(r"^(xiaoman_daily_case_report_worker_private_review_bundle_(?:quote_map_entry_count|wiki_people_count|wiki_event_count|wiki_storyline_count))=([0-9]{1,6})$"),
]
details = []
seen = set()
if path.is_file():
    lines = [line.strip() for line in path.read_text(encoding="utf-8", errors="replace").splitlines()]
    lines = [line for line in lines if line]
    for line in lines:
        for pattern in safe_patterns:
            match = pattern.fullmatch(line)
            if not match:
                continue
            item = f"{match.group(1)}={match.group(2)}"
            if item not in seen:
                seen.add(item)
                details.append(item)
print("; ".join(details) if details else "observation_passed")
PY
}

observation_failure_detail() {
  local status="$1"
  local primary_log_file="$2"
  local secondary_log_file="$3"
  python3 - "$status" "$primary_log_file" "$secondary_log_file" <<'PY'
import re
import sys
from pathlib import Path

status, primary_path, secondary_path = sys.argv[1:4]

def has_output(path):
    file_path = Path(path)
    if not file_path.is_file():
        return False
    return bool(file_path.read_text(encoding="utf-8", errors="replace").strip())

worker_error_pattern = re.compile(r"^([a-z0-9_]+_(?:worker_run|observation)_error)=([a-z0-9_]+)$")
worker_errors = []
seen = set()
primary_file = Path(primary_path)
if primary_file.is_file():
    lines = [
        line.strip()
        for line in primary_file.read_text(encoding="utf-8", errors="replace").splitlines()
    ]
    for line in lines:
        match = worker_error_pattern.fullmatch(line)
        if not match:
            continue
        item = f"{match.group(1)}={match.group(2)}"
        if item not in seen:
            seen.add(item)
            worker_errors.append(item)

parts = []
if worker_errors:
    parts.extend(worker_errors)
else:
    if has_output(primary_path):
        parts.append("enabled_attempt=failed")
    if has_output(secondary_path):
        parts.append("disabled_attempt=failed")
detail = f"exit {status}"
if parts:
    detail = f"{detail}: " + "; ".join(parts)
detail = re.sub(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]", " ", detail)
print(detail[:300])
PY
}


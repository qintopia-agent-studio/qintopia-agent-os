{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qintopia-agent-os.local/schemas/deploy-result.schema.json",
  "title": "Qintopia Agent OS Deploy Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "environment",
    "status",
    "started_at",
    "finished_at",
    "release_scope",
    "previous_sha",
    "current_target",
    "restart_targets",
    "checks",
    "rollback",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "environment": { "enum": ["production"] },
    "status": { "enum": ["succeeded", "failed", "rolled_back", "dry_run_succeeded"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "release_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "runtime_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "runtime_artifact_profile": {
      "enum": ["huabaosi-production", "qiwe-production"]
    },
    "deploy_bundle_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hermes_core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "commit_sha",
        "source_archive_sha256",
        "artifact_identity_sha256",
        "artifact_manifest_sha256",
        "previous_commit_sha",
        "new_version",
        "transaction_status"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "source_archive_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact_identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "previous_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "new_version": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
        },
        "transaction_status": {
          "enum": ["committed", "already_committed", "rolled_back"]
        }
      }
    },
    "release_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "sidecar-runtime",
          "deploy-bundle",
          "hermes-plugins",
          "hermes-core-release",
          "hermes-profile-erhua",
          "production-activation",
          "production-observation",
          "production-hermes-cron-apply",
          "production-legacy-cron-retirement",
          "production-runtime-one-shot"
        ]
      }
    },
    "previous_sha": { "type": "string" },
    "current_target": { "type": "string" },
    "restart_targets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["passed", "failed", "skipped"] },
          "detail": { "type": "string" }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "status"],
      "properties": {
        "attempted": { "type": "boolean" },
        "status": { "enum": ["not_needed", "succeeded", "failed", "skipped"] },
        "target": { "type": "string" }
      }
    },
    "validation_failure": { "type": "boolean" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "issuer", "key_id", "signed_at", "value"],
      "properties": {
        "algorithm": { "const": "hmac-sha256" },
        "issuer": { "const": "qintopia-deploy-runner" },
        "key_id": { "type": "string", "minLength": 1 },
        "signed_at": { "type": "string", "format": "date-time" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "error": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "release_scope": { "const": ["hermes-core-release"] },
          "validation_failure": { "not": { "const": true } }
        },
        "required": ["release_scope"]
      },
      "then": {
        "required": ["hermes_core"],
        "properties": {
          "restart_targets": { "const": ["hermes-core"] },
          "current_target": { "const": "" },
          "previous_sha": { "const": "" }
        },
        "not": {
          "anyOf": [
            { "required": ["release_sha"] },
            { "required": ["commit_sha"] },
            { "required": ["runtime_sha"] },
            { "required": ["runtime_artifact_profile"] },
            { "required": ["deploy_bundle_sha"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "release_scope": {
            "not": { "const": ["hermes-core-release"] }
          },
          "validation_failure": { "not": { "const": true } }
        },
        "required": ["release_scope"]
      },
      "then": {
        "required": [
          "release_sha",
          "commit_sha",
          "runtime_sha",
          "runtime_artifact_profile",
          "deploy_bundle_sha"
        ],
        "not": { "required": ["hermes_core"] }
      }
    },
    {
      "if": {
        "properties": { "validation_failure": { "const": true } },
        "required": ["validation_failure"]
      },
      "then": {
        "properties": {
          "release_scope": { "const": ["production-observation"] },
          "restart_targets": { "const": ["qintopia-system-services"] }
        },
        "required": ["error"],
        "not": { "required": ["hermes_core"] }
      }
    }
  ]
}

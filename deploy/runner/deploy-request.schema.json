{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qintopia-agent-os.local/schemas/deploy-request.schema.json",
  "title": "Qintopia Agent OS Deploy Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "environment",
    "repository",
    "requested_by",
    "created_at",
    "expires_at",
    "commit_sha",
    "runtime_sha",
    "runtime_artifact_profile",
    "deploy_bundle_sha",
    "release_sha",
    "release_scope",
    "restart_targets",
    "rollback_on_smoke_failure",
    "dry_run",
    "cos",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": {
      "type": "string",
      "pattern": "^deploy-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7,40}$"
    },
    "environment": { "enum": ["production"] },
    "repository": { "const": "qintopia-agent-studio/qintopia-agent-os" },
    "requested_by": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "runtime_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "runtime_artifact_profile": {
      "enum": ["huabaosi-production", "qiwe-production"]
    },
    "deploy_bundle_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "release_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "release_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "sidecar-runtime",
          "deploy-bundle",
          "hermes-plugins",
          "hermes-profile-erhua",
          "production-activation",
          "production-observation",
          "production-hermes-cron-apply",
          "production-legacy-cron-retirement",
          "production-runtime-one-shot"
        ]
      }
    },
    "restart_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "qintopia-system-services",
          "hermes-erhua",
          "hermes-wenyuange",
          "hermes-xiaoman",
          "hermes-silaoshi",
          "hermes-huabaosi",
          "hermes-guanerye"
        ]
      }
    },
    "rollback_on_smoke_failure": { "type": "boolean" },
    "dry_run": { "type": "boolean" },
    "profile_dry_run_request_id": {
      "type": "string",
      "pattern": "^deploy-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7,40}$"
    },
    "cos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "region", "prefix", "request_key", "result_key"],
      "properties": {
        "bucket": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "prefix": { "type": "string", "minLength": 1 },
        "request_key": {
          "type": "string",
          "pattern": "^qintopia-agent-os/deploy-requests/production/requests/.+\\.json$"
        },
        "result_key": {
          "type": "string",
          "pattern": "^qintopia-agent-os/deploy-results/production/.+\\.json$"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "issuer", "key_id", "signed_at", "value"],
      "properties": {
        "algorithm": { "const": "hmac-sha256" },
        "issuer": { "const": "github-actions" },
        "key_id": { "type": "string", "minLength": 1 },
        "signed_at": { "type": "string", "format": "date-time" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflow": { "type": "string" },
        "run_id": { "type": "string" },
        "run_attempt": { "type": "string" },
        "ref": { "type": "string" },
        "sha": { "type": "string" }
      }
    },
    "notes": { "type": "string" },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets"],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "erhua-morning-brief",
              "xiaoman-weekly-recruitment",
              "xiaoman-weekly-plan-confirmation",
              "xiaoman-weekly-preview",
              "xiaoman-daily-case-report-auto-publish"
            ]
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets"],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "qiwe-image-send",
              "xiaoman-daily-case-report-auto-publish",
              "hermes-cron-snapshot",
              "hermes-cron-live-parity",
              "erhua-morning-brief-worker-run",
              "xiaoman-daily-case-report-worker-run",
              "xiaoman-weekly-recruitment-worker-run",
              "xiaoman-weekly-plan-confirmation-worker-run",
              "xiaoman-weekly-preview-worker-run"
            ]
          }
        }
      }
    },
    "legacy_cron_retirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets"],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["erhua-legacy-cron", "xiaoman-legacy-cron"]
          }
        }
      }
    },
    "hermes_cron_apply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "mode"],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "erhua-morning-brief",
              "xiaoman-daily-case-report",
              "xiaoman-weekly-recruitment",
              "xiaoman-weekly-plan-confirmation",
              "xiaoman-weekly-preview"
            ]
          }
        },
        "mode": { "enum": ["install", "enable"] }
      }
    },
    "runtime_one_shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "approval"],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "erhua-morning-brief",
              "hermes-cron-snapshot-install",
              "xiaoman-daily-case-report-auto-publish-backfill",
              "xiaoman-daily-case-report-approval-repair",
              "xiaoman-daily-case-report-read-through-repair",
              "xiaoman-daily-case-report-chat-id-repair",
              "xiaoman-daily-case-report-target-group-id-repair",
              "xiaoman-daily-case-report-storage-backend-repair",
              "xiaoman-creative-profile-candidates-apply"
            ]
          }
        },
        "backfill_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "approval": {
          "enum": [
            "approved-production-hermes-cron-snapshot",
            "approved-production-erhua-morning-brief-one-shot",
            "approved-production-xiaoman-daily-case-report-auto-publish-backfill",
            "approved-production-xiaoman-daily-case-report-config-v1",
            "approved-production-xiaoman-creative-profile-candidates"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "targets": {
                "type": "array",
                "contains": {
                  "const": "xiaoman-daily-case-report-auto-publish-backfill"
                }
              }
            },
            "required": ["targets"]
          },
          "then": {
            "required": ["backfill_date"],
            "properties": {
              "approval": {
                "const": "approved-production-xiaoman-daily-case-report-auto-publish-backfill"
              }
            },
            "not": { "required": ["payload_sha256"] }
          }
        },
        {
          "if": {
            "properties": {
              "targets": {
                "type": "array",
                "contains": {
                  "const": "xiaoman-daily-case-report-approval-repair"
                }
              }
            },
            "required": ["targets"]
          },
          "then": {
            "properties": {
              "approval": {
                "const": "approved-production-xiaoman-daily-case-report-config-v1"
              }
            },
            "not": {
              "anyOf": [
                { "required": ["backfill_date"] },
                { "required": ["payload_sha256"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "targets": {
                "type": "array",
                "contains": {
                  "const": "xiaoman-daily-case-report-chat-id-repair"
                }
              }
            },
            "required": ["targets"]
          },
          "then": {
            "properties": {
              "approval": {
                "const": "approved-production-xiaoman-daily-case-report-config-v1"
              }
            },
            "not": {
              "anyOf": [
                { "required": ["backfill_date"] },
                { "required": ["payload_sha256"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "targets": {
                "type": "array",
                "contains": {
                  "const": "xiaoman-daily-case-report-target-group-id-repair"
                }
              }
            },
            "required": ["targets"]
          },
          "then": {
            "properties": {
              "approval": {
                "const": "approved-production-xiaoman-daily-case-report-config-v1"
              }
            },
            "not": {
              "anyOf": [
                { "required": ["backfill_date"] },
                { "required": ["payload_sha256"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "targets": {
                "type": "array",
                "contains": {
                  "const": "xiaoman-daily-case-report-read-through-repair"
                }
              }
            },
            "required": ["targets"]
          },
          "then": {
            "properties": {
              "approval": {
                "const": "approved-production-xiaoman-daily-case-report-config-v1"
              }
            },
            "not": {
              "anyOf": [
                { "required": ["backfill_date"] },
                { "required": ["payload_sha256"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "targets": {
                "type": "array",
                "contains": { "const": "erhua-morning-brief" }
              }
            },
            "required": ["targets"]
          },
          "then": {
            "properties": {
              "approval": {
                "const": "approved-production-erhua-morning-brief-one-shot"
              }
            },
            "not": {
              "anyOf": [
                { "required": ["backfill_date"] },
                { "required": ["payload_sha256"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "targets": {
                "type": "array",
                "contains": { "const": "hermes-cron-snapshot-install" }
              }
            },
            "required": ["targets"]
          },
          "then": {
            "properties": {
              "approval": {
                "const": "approved-production-hermes-cron-snapshot"
              }
            },
            "not": {
              "anyOf": [
                { "required": ["backfill_date"] },
                { "required": ["payload_sha256"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "targets": {
                "type": "array",
                "contains": {
                  "const": "xiaoman-creative-profile-candidates-apply"
                }
              }
            },
            "required": ["targets"]
          },
          "then": {
            "required": ["payload_sha256"],
            "properties": {
              "approval": {
                "const": "approved-production-xiaoman-creative-profile-candidates"
              }
            },
            "not": { "required": ["backfill_date"] }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "release_scope": {
            "type": "array",
            "contains": { "const": "hermes-profile-erhua" }
          }
        }
      },
      "then": {
        "properties": {
          "release_scope": { "const": ["hermes-profile-erhua"] },
          "restart_targets": { "const": ["hermes-erhua"] },
          "rollback_on_smoke_failure": { "const": true }
        }
      }
    },
    {
      "if": {
        "properties": {
          "release_scope": { "const": ["hermes-profile-erhua"] },
          "dry_run": { "const": false }
        },
        "required": ["release_scope", "dry_run"]
      },
      "then": { "required": ["profile_dry_run_request_id"] }
    },
    {
      "if": {
        "properties": {
          "release_scope": {
            "type": "array",
            "contains": { "const": "production-activation" }
          }
        }
      },
      "then": {
        "required": ["activation"],
        "properties": {
          "release_scope": { "const": ["production-activation"] },
          "restart_targets": { "const": ["qintopia-system-services"] },
          "dry_run": { "const": false },
          "rollback_on_smoke_failure": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": {
          "release_scope": {
            "type": "array",
            "not": { "contains": { "const": "production-activation" } }
          }
        },
        "required": ["release_scope"]
      },
      "then": {
        "not": { "required": ["activation"] }
      }
    },
    {
      "if": {
        "properties": {
          "release_scope": {
            "type": "array",
            "contains": { "const": "production-observation" }
          }
        }
      },
      "then": {
        "required": ["observation"],
        "properties": {
          "release_scope": { "const": ["production-observation"] },
          "restart_targets": { "const": ["qintopia-system-services"] },
          "dry_run": { "const": false },
          "rollback_on_smoke_failure": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": {
          "release_scope": {
            "type": "array",
            "not": { "contains": { "const": "production-observation" } }
          }
        },
        "required": ["release_scope"]
      },
      "then": {
        "not": { "required": ["observation"] }
      }
    },
    {
      "if": {
        "properties": {
          "release_scope": {
            "type": "array",
            "contains": { "const": "production-legacy-cron-retirement" }
          }
        }
      },
      "then": {
        "required": ["legacy_cron_retirement"],
        "properties": {
          "release_scope": { "const": ["production-legacy-cron-retirement"] },
          "restart_targets": { "const": ["qintopia-system-services"] },
          "dry_run": { "const": false },
          "rollback_on_smoke_failure": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": {
          "release_scope": {
            "type": "array",
            "not": { "contains": { "const": "production-legacy-cron-retirement" } }
          }
        },
        "required": ["release_scope"]
      },
      "then": {
        "not": { "required": ["legacy_cron_retirement"] }
      }
    },
    {
      "if": {
        "properties": {
          "release_scope": {
            "type": "array",
            "contains": { "const": "production-hermes-cron-apply" }
          }
        }
      },
      "then": {
        "required": ["hermes_cron_apply"],
        "properties": {
          "release_scope": { "const": ["production-hermes-cron-apply"] },
          "restart_targets": { "const": ["qintopia-system-services"] },
          "dry_run": { "const": false },
          "rollback_on_smoke_failure": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": {
          "release_scope": {
            "type": "array",
            "not": { "contains": { "const": "production-hermes-cron-apply" } }
          }
        },
        "required": ["release_scope"]
      },
      "then": {
        "not": { "required": ["hermes_cron_apply"] }
      }
    },
    {
      "if": {
        "properties": {
          "release_scope": {
            "type": "array",
            "contains": { "const": "production-runtime-one-shot" }
          }
        }
      },
      "then": {
        "required": ["runtime_one_shot"],
        "properties": {
          "release_scope": { "const": ["production-runtime-one-shot"] },
          "restart_targets": { "const": ["qintopia-system-services"] },
          "dry_run": { "const": false },
          "rollback_on_smoke_failure": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": {
          "release_scope": {
            "type": "array",
            "not": { "contains": { "const": "production-runtime-one-shot" } }
          }
        },
        "required": ["release_scope"]
      },
      "then": {
        "not": { "required": ["runtime_one_shot"] }
      }
    }
  ]
}
